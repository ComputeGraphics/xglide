<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:fltstd26.Resources.Texts"
             xmlns:gs="clr-namespace:fltstd26.etc"
             BackgroundColor="#88000000"
             x:Class="fltstd26.XFly.TargetCustomizer"
             Title="TargetCustomizer">
    <Border StrokeThickness="2"
            WidthRequest="600"
            BackgroundColor="{x:AppThemeBinding Dark={StaticResource Gray950}, Light={StaticResource Gray200}}"
            VerticalOptions="Center"
            HorizontalOptions="Center">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              Padding="20">
            <Label FontSize="28"
                   Text="{x:Static local:Lang.targetcustomizer}"
                   FontAttributes="Bold"
                   FontFamily="Archive"
                   HorizontalOptions="Center"
                   Grid.Row="0"/>
            <VerticalStackLayout x:Name="TargetOptionsStack"
                                 HorizontalOptions="Fill"
                                 Padding="15"
                                 Grid.Row="1"
                                 IsVisible="False">
                <Label FontSize="18"
                       Text="{x:Static local:Lang.target_option}"
                       Margin="0,5"
                       HorizontalOptions="Start"
                       Grid.Row="1"/>
                <Entry x:Name="TGT_Name_Entry"
                       Placeholder="{x:Static local:Lang.xplan_name}"
                       MaxLength="25"
                       IsSpellCheckEnabled="False"
                       ClearButtonVisibility="WhileEditing"
                       Margin="0,10,0,10"/>
                <Entry x:Name="TGT_Weight_Entry"
                       Margin="0,10,0,10"
                       Keyboard="Numeric">
                    <Entry.Behaviors>
                        <toolkit:NumericValidationBehavior 
                                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                                    ValidStyle="{StaticResource ValidEntryStyle}"
                                    Flags="ValidateOnValueChanged"
                                    MinimumValue="1.0"
                                    MaximumValue="255"
                                    MaximumDecimalPlaces="1" />
                    </Entry.Behaviors>
                </Entry>
                <Entry x:Name="TGT_Price_Entry"
                       Placeholder="{x:Static local:Lang.xplan_price}"
                       Margin="0,10,0,10"
                       IsVisible="False"
                       Keyboard="Numeric"/>

                <Grid ColumnDefinitions="*, *">
                    <HorizontalStackLayout>
                        <CheckBox x:Name="TGT_Quickticket_Enable"/>
                        <Label Text="{x:Static local:Lang.xplan_quickticket}" 
                                    VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1">
                        <CheckBox x:Name="TGT_Persistent_Enable"/>
                        <Label Text="{x:Static local:Lang.xplan_persistent}" 
                                    VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="FlightOptionsStack"
                                 HorizontalOptions="Fill"
                                 Padding="15"
                                 Grid.Row="2"
                                 IsVisible="False">
                <Label FontSize="18"
                       x:Name="FlightOptionHeader"
                       Text="{x:Static local:Lang.flight_option}"
                       Margin="0,5"
                       HorizontalOptions="Start"
                       Grid.Row="1"/>

                <Entry x:Name="FLT_EID_Entry"
                       MaxLength="25"
                       IsSpellCheckEnabled="False"
                       ClearButtonVisibility="WhileEditing"
                       Margin="0,10,0,10"/>

                <Grid ColumnDefinitions="Auto, *">
                    <HorizontalStackLayout>
                        <CheckBox x:Name="FLT_Status_Dropdown_Enable"
                                          IsChecked="True"/>
                        <Label Text="{x:Static local:Lang.unchanged}" 
                                    VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Picker x:Name="FLT_Status_Dropdown"
                                    Grid.Column="1"
                                    WidthRequest="100"
                                    ItemsSource="{x:Static gs:GSettings.Status}"
                                    Margin="0,10,0,10"
                                    BindingContext="{x:Reference FLT_Status_Dropdown_Enable}"
                                    IsEnabled="{Binding Path=IsChecked, Converter={toolkit:InvertedBoolConverter}}"/>
                </Grid>

                <VerticalStackLayout x:Name="FLTAddsEntryContainer"
                     Padding="0,10,0,0"/>
            </VerticalStackLayout>
            <Grid Grid.Row="3"
                  x:Name="ButtonGrid"
                  Padding="0,10,0,0"
              ColumnSpacing="10"
              ColumnDefinitions="*,*">
                <Button Text="{x:Static local:Lang.cancel}"
                    CornerRadius="0"
                        Clicked="OnCancel"/>
                <Button Text="{x:Static local:Lang.confirm}"
                    CornerRadius="0"
                    Grid.Column="1"
                        Clicked="OnConfirm"/>
            </Grid>
        </Grid>
    </Border>
</ContentPage>