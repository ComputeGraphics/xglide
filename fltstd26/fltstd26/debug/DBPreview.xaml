<?xml version="1.0" encoding="utf-8" ?>
<Window xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        x:Class="fltstd26.debug.DBPreview"
        xmlns:local="clr-namespace:fltstd26.Resources.Texts"
        Title="DBPreview">

    <ContentPage>
        <ScrollView
                VerticalOptions="Fill"
                VerticalScrollBarVisibility="Always">
            <VerticalStackLayout>
                <HorizontalStackLayout Margin="10">
                    <Label Text="Database Preview"
                       FontSize="Medium"
                       FontAttributes="Bold"/>
                    <Picker x:Name="DBPreviewPicker"
                        HorizontalOptions="Center">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Flights</x:String>
                                <x:String>Aircraft</x:String>
                                <x:String>Slots</x:String>
                                <x:String>Targets</x:String>
                                <x:String>Prices</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                    <Button Text="Refresh"
                        ImageSource="refresh.png"
                        Clicked="Refresh_Click"
                        HorizontalOptions="End"/>
                </HorizontalStackLayout>

                <Grid x:Name="DBPreviewGrid"/>

            </VerticalStackLayout>
        </ScrollView>

    </ContentPage>
</Window>