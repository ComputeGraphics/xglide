<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:uset="clr-namespace:fltstd26.etc"
             x:Class="fltstd26.board.BoardPage"
             Title="">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
              Padding="15,10"
              ColumnSpacing="35"
              BackgroundColor="{AppThemeBinding Dark={StaticResource PrimaryDark}, Light={StaticResource Primary}}">
            <Image Aspect="AspectFit"
                   WidthRequest="{Binding Source={x:Static uset:USettings.LogoSize_L}}"
                   x:Name="TopIconL"/>
            <Label HorizontalOptions="Start"
                   Grid.Column="1"
                   VerticalOptions="Center"
                   FontFamily="ZenDots"
                   FontSize="{Binding Source={x:Static uset:USettings.TitleSize}}"
                   x:Name="BoardTitle"/>
            <Image Aspect="AspectFit"
                   WidthRequest="{Binding Source={x:Static uset:USettings.LogoSize_R}}"
                   Grid.Column="2"
                   x:Name="TopIconR"/>
            <VerticalStackLayout Grid.Column="3"
                                 VerticalOptions="Center">
                <Label x:Name="BoardTime"
                       HorizontalOptions="Center"
                       FontSize="{Binding Source={x:Static uset:USettings.ClockSize}}"
                       FontFamily="SquareSans"
                       FontAttributes="Bold"/>
                <Label x:Name="BoardDate"
                       HorizontalOptions="Center"
                       FontSize="{Binding Source={x:Static uset:USettings.DateSize}}"
                       FontFamily="ZenDots"/>
            </VerticalStackLayout>
        </Grid>
        <Grid Grid.Row="1"
              RowDefinitions="Auto,*">
            <Grid x:Name="XTitles"/>
            <ScrollView Grid.Row="1">
                <VerticalStackLayout 
                  BackgroundColor="{AppThemeBinding Dark={StaticResource Gray800}, Light={StaticResource Gray200}}"
                  x:Name="XBoard"/>
            </ScrollView>
        </Grid>
        <Grid Grid.Row="2">
            <Label Text="Message Center"/>
        </Grid>
    </Grid>
</ContentPage>