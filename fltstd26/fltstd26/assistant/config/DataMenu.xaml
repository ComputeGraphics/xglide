<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:fltstd26.Resources.Texts"
             x:Class="fltstd26.assistant.config.DataMenu">
    <VerticalStackLayout Padding="20"
                         HorizontalOptions="Start"
                         MinimumWidthRequest="800"
                         MaximumWidthRequest="1200">
        <Label 
            Text="{x:Static local:Lang.settings_data_title}"
            VerticalOptions="Center"
            FontSize="Medium"
            FontFamily="Archive"
            HorizontalOptions="Start" />
        <Border HorizontalOptions="Fill"
                Padding="10"
                MinimumWidthRequest="800"
                Margin="0,20">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto"
                      Padding="10,0,0,0">
                    <Label Text="{x:Static local:Lang.additionals}"
                           FontSize="Subtitle"
                           VerticalOptions="Center"/>
                    <Button Text="{x:Static local:Lang.xplan_add}"
                        CornerRadius="0"
                            ImageSource="plus.png"
                            Clicked="AddAdditional"
                        Grid.Column="1"/>
                </Grid>
                <VerticalStackLayout x:Name="AdditionalStack"
                                     Spacing="8"/>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
