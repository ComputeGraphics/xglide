<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="fltstd26.assistant.config.SidebarItem">
    <Grid ColumnDefinitions="Auto,Auto,*"
          x:Name="GridControl"
          ColumnSpacing="10"
          RowDefinitions="*,*">
        <Rectangle Fill="{StaticResource Primary}"
                   VerticalOptions="Fill"
                   IsVisible="False"
                   x:Name="IndicatorControl"
                   Grid.RowSpan="2"
                   WidthRequest="8"/>
        <Image x:Name="IconControl"
               Grid.Column="1"
               Grid.RowSpan="2">
            <Image.Behaviors>
                <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Dark={StaticResource White}, Light={StaticResource Black}}"/>
            </Image.Behaviors>
        </Image>
        <Label x:Name="TitleControl"
               FontSize="18"
               VerticalOptions="Center"
               Grid.Column="2"
               FontAttributes="Bold"/>
        <Label x:Name="SubtitleControl"
               FontSize="16"
               VerticalOptions="Center"
               Grid.Row="1"
               Grid.Column="2"/>
    </Grid>
</ContentView>
