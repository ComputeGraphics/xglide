<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:fltstd26.Resources.Texts"
             x:Class="fltstd26.assistant.config.UxMenu">
    <VerticalStackLayout Padding="20"
                         HorizontalOptions="Start"
                         MinimumWidthRequest="600"
                         MaximumWidthRequest="800">
        <Label Text="{x:Static local:Lang.settings_planner_title}"
               VerticalOptions="Center"
               FontSize="Medium"
               FontFamily="Archive"
               HorizontalOptions="Start" />
        <ScrollView>
            <Grid ColumnDefinitions="*,Auto,Auto"
                  RowDefinitions="Auto,Auto,Auto,Auto">
                <Label Text="{x:Static local:Lang.askfornodemove}"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"/>
                <Switch x:Name="AskForNodeMoveControl"
                        Grid.Column="2"
                        Toggled="SyncSwitch"/>
                <Label Text="{x:Static local:Lang.askforpricechange}"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       Grid.Row="1"/>
                <Switch x:Name="AskForNodePriceChangeControl"
                        Grid.Column="2"
                        Grid.Row="1"
                        Toggled="SyncSwitch"/>
                <Label Text="{x:Static local:Lang.hidepastslots}"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       Grid.Row="2"/>
                <Switch x:Name="HidePastSlotsControl"
                        Grid.Column="2"
                        Grid.Row="2"
                        Toggled="SyncSwitch"/>

                <Label Text="{x:Static local:Lang.slottolerance}"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       Grid.Row="3"/>
                <Label HorizontalOptions="Center"
                       Text="{Binding x:DataType='Stepper', Source={x:Reference SlotToleranceControl}, Path=Value}"
                       VerticalOptions="Center"
                       FontAttributes="Bold"
                       Grid.Row="3"
                       Grid.Column="1"/>
                <Stepper x:Name="SlotToleranceControl"
                         ValueChanged="SyncSettings"
                         Maximum="90"
                         Minimum="0"
                         Increment="1"
                         HorizontalOptions="End"
                         Grid.Row="3"
                         Grid.Column="2"/>

            </Grid>
        </ScrollView>
    </VerticalStackLayout>
</ContentView>
