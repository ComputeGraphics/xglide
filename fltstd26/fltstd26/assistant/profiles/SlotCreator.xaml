<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fltstd26.assistant.profiles.SlotCreator"
             xmlns:local="clr-namespace:fltstd26.Resources.Texts"
             BackgroundColor="#88000000"
             Title="SlotCreator">
    <Border StrokeThickness="2"
            WidthRequest="700"
            BackgroundColor="{x:AppThemeBinding Dark={StaticResource Gray950}, Light={StaticResource Gray200}}"
            VerticalOptions="Center"
            HorizontalOptions="Center">
        <Grid RowDefinitions="Auto,Auto,Auto"
              Padding="20">
            <Label FontSize="28"
                    Text="{x:Static local:Lang.price_create}"
                    FontAttributes="Bold"
                    FontFamily="Archive"
                    HorizontalOptions="Center"
                    Grid.Row="0"/>
            <Grid ColumnDefinitions="*,*"
                  Grid.Row="1"
                  ColumnSpacing="10"
                  RowSpacing="5"
                  RowDefinitions="*,Auto">
                <Border Margin="0,10"
                        Padding="10">
                <VerticalStackLayout Spacing="15"
                                     HorizontalOptions="Fill">
                    <Label Text="{x:Static local:Lang.start}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           FontSize="22"/>
                    <DatePicker FontFamily="ZenDots"
                                HorizontalOptions="Center"
                                WidthRequest="250"
                                x:Name="SDatePicker"/>
                    <TimePicker FontAttributes="Bold"
                                FontSize="18"
                                Format="HH:mm"
                                WidthRequest="250"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                x:Name="STimePicker"/>
                </VerticalStackLayout>
                </Border>
                <Border Margin="0,10"
                        Padding="10"
                        Grid.Column="1">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="{x:Static local:Lang.end}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           FontSize="22"/>
                        <DatePicker FontFamily="ZenDots"
                                HorizontalOptions="Center"
                                WidthRequest="250"
                                x:Name="FDatePicker"/>
                        <TimePicker FontAttributes="Bold"
                                FontSize="18"
                                WidthRequest="250"
                                Format="HH:mm"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                x:Name="FTimePicker"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.ColumnSpan="2"
                        Margin="0,0,0,20"
                        Padding="10"
                        Grid.Row="1">
                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="Center">
                    <Label Text="{x:Static local:Lang.length_doubledot}"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"/>
                    <Entry x:Name="LengthEntry"
                                   MaxLength="64"
                           WidthRequest="400"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Fill"
                                   Placeholder="{x:Static local:Lang.xplan_length}"/>
                </HorizontalStackLayout>
                </Border>
            </Grid>
            <Grid Grid.Row="2"
                x:Name="ButtonGrid"
                Padding="0,10,0,0"
                ColumnSpacing="10"
                ColumnDefinitions="*,*">
                <Button Text="{x:Static local:Lang.cancel}"
                        CornerRadius="0"
                        Clicked="CancelClick"/>
                <Button Text="{x:Static local:Lang.xplan_add}"
                        CornerRadius="0"
                        Grid.Column="1"
                        Clicked="AddClick"/>
            </Grid>
        </Grid>


    </Border>
</ContentPage>