<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fltstd26.assistant.profiles.PriceCatCreator"
             xmlns:local="clr-namespace:fltstd26.Resources.Texts"
             BackgroundColor="#88000000"
             Title="PriceCatCreator">
    <Border StrokeThickness="2"
            WidthRequest="600"
            BackgroundColor="{x:AppThemeBinding Dark={StaticResource Gray950}, Light={StaticResource Gray200}}"
            VerticalOptions="Center"
            HorizontalOptions="Center">
        <Grid RowDefinitions="Auto,Auto,Auto"
              Padding="20">
            <Label FontSize="28"
                    Text="{x:Static local:Lang.price_create}"
                    FontAttributes="Bold"
                    FontFamily="Archive"
                    HorizontalOptions="Center"
                    Grid.Row="0"/>
            <VerticalStackLayout Spacing="10"
                                 Grid.Row="1">
                <HorizontalStackLayout Spacing="10"
                                       Margin="0,20,0,10"
                                       HorizontalOptions="Center">
                    <Label Text="{x:Static local:Lang.name_doubledot}"
                                   HorizontalOptions="End"
                           
                                   VerticalOptions="Center"/>
                    <Entry x:Name="NameEntry"
                                   MaxLength="64"
                           WidthRequest="400"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Fill"
                                   Placeholder="{x:Static local:Lang.xplan_name}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="10"
                                       Margin="0,0,0,20"
                                       HorizontalOptions="Center"
                                             Grid.Row="1">
                    <Label Text="{x:Static local:Lang.price_doubledot}"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"/>
                    <Entry x:Name="PriceEntry"
                                   MaxLength="64"
                           WidthRequest="400"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Fill"
                                   Placeholder="{x:Static local:Lang.xplan_price}"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Grid Grid.Row="2"
                  x:Name="ButtonGrid"
                  Padding="0,10,0,0"
              ColumnSpacing="10"
              ColumnDefinitions="*,*">
                <Button Text="{x:Static local:Lang.cancel}"
                    CornerRadius="0"
                        Clicked="CancelClick"/>
                <Button Text="{x:Static local:Lang.xplan_add}"
                    CornerRadius="0"
                    Grid.Column="1"
                        Clicked="AddClick"/>
            </Grid>
        </Grid>
    </Border>
</ContentPage>