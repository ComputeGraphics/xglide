<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fltstd26.assistant.IABoard"
             Title=""
             xmlns:local="clr-namespace:fltstd26.Resources.Texts">
    <Grid RowDefinitions="Auto,*,Auto">
        <Label 
            Text="{x:Static local:Lang.iaboard}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            Grid.Row="0"/>

        <StackLayout Spacing="20"  Grid.Row="1" HorizontalOptions="Center">
            <HorizontalStackLayout>
                <Button
                        Text="{x:Static local:Lang.iaboard_add}"
                        HorizontalOptions="Start"
                        Clicked="IABoard_Add_Clicked"/>
            </HorizontalStackLayout>
            <ScrollView Margin="10">

                <Grid x:Name="IABoard_Grid"
                      RowSpacing="10"
                      ColumnSpacing="10"
                      ColumnDefinitions="Auto,*,*,Auto"
                      RowDefinitions="Auto">

                    <Label 
                        Text="{x:Static local:Lang.iaboard_visibility}"
                        FontAttributes="Bold"
                        Grid.Row="0"
                        Grid.Column="0"/>
                    <Label 
                        Text="{x:Static local:Lang.iaboard_name}"
                        FontAttributes="Bold"
                        Grid.Row="0"
                        Grid.Column="1"/>
                    <Label 
                        Text="{x:Static local:Lang.iaboard_binding}"
                        FontAttributes="Bold"
                        Grid.Row="0"
                        Grid.Column="2"/>
                    <Label 
                        Text="{x:Static local:Lang.iaboard_width}"
                        FontAttributes="Bold"
                        Grid.Row="0"
                        Grid.Column="3"/>

                </Grid>

            </ScrollView>

        </StackLayout>

        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="End" Margin="0,10">
            <Button 
                Text="{x:Static local:Lang.assistant_continue}"
                HorizontalOptions="End"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>